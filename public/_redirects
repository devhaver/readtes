# Cloudflare Pages: reader pages of the interface languages that are not
# prerendered (see SPA_READER_LOCALES in nuxt.config.ts) are served by the
# app shell, which renders the chapter in the browser. Status 200: a rewrite,
# not a redirect — the URL stays /<code>/read/... .
/es/read/* /200.html 200
/fr/read/* /200.html 200
/de/read/* /200.html 200
/pt/read/* /200.html 200
/tr/read/* /200.html 200
/uk/read/* /200.html 200

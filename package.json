{
  "name": "readtes",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxi typecheck && vue-tsc -p tsconfig.scripts.json --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "emit:toc-splits": "tsx scripts/emit-toc-splits.ts",
    "emit:glossary-splits": "tsx scripts/emit-glossary-splits.ts",
    "import:sefaria": "tsx scripts/import-sefaria.ts",
    "import:kabbalahmedia": "tsx scripts/import-kabbalahmedia.ts",
    "migrate:consolidate-qa": "tsx scripts/migrate-consolidate-qa.ts"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^14.4.0",
    "nuxt": "^4.5.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.4.1",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "zod": "^4.4.3"
  }
}

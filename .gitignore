# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# pnpm content-addressable store — can land in the repo root when the
# dev container (running as root in the bind-mounted tree) falls back to a
# project-local store instead of PNPM_HOME.
.pnpm-store/

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Test coverage
coverage
playwright-report
test-results

# Written automatically by @nuxt/test-utils on first vitest run
.nuxtrc

# Superpowers agent scratch state
.superpowers/

# go-task cache/checksum state
.task/

# Claude Code — share settings.json, keep personal/machine state local.
# worktrees/ holds throwaway agent checkouts (each a full node_modules).
.claude/settings.local.json
.claude/worktrees/
.translation/

# Python bytecode from the translation gates
__pycache__/
*.pyc
